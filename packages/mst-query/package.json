{
    "name": "mst-query",
    "version": "5.0.0",
    "description": "Query library for mobx-state-tree",
    "source": "src/index.ts",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "watch": "vitest",
        "test": "vitest run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ConrabOpto/mst-query.git"
    },
    "author": "Conrab Opto (www.conrabopto.se)",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "jsdom": "31.0.0",
        "mobx": "7.1.5",
        "mobx-react": "10.0.3",
        "mobx-state-tree": "9.0.1",
        "prettier": "3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tsdown": "0.23.5",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "mobx": ">=7.0.0 <8.0.0",
        "mobx-state-tree": ">=9.0.0 <10.0.0",
        "react": ">=19.0.0 <20.0.0",
        "react-dom": ">=19.0.0 <20.0.0"
    },
    "dependencies": {
        "@wry/equality": "0.5.7"
    },
    "volta": {
        "node": "24.22.2"
    }
}
