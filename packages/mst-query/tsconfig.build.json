{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "jsx": "react-jsx",
        "lib": ["ESNext", "dom"],
        "declaration": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitAny": true,
        "alwaysStrict": true,
        "moduleResolution": "Bundler",
        "experimentalDecorators": true
    },
    "include": ["./src"]
}
